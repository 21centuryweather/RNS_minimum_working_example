                     fp.write("sort-key=rg{0:02d}_rs{1:02d}-a\n".format(rg, rs))
                     fp.write("title=rg{0:02d}_rs{1:02d}_std_model\n".format(rg, rs))
                     fp.write("description=User specified grid (the original option).\n")
                     fp.write("           =Alternatively choose the current UKV with\n")
                     fp.write("           =70/90 levels or RAL3 science.\n")
