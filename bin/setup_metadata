import sys
import os
from textwrap import dedent

def set_suite_conf(f, nrg, nrs, nm):
    try:
        with open(f, "w") as fp:
             fp.write("[jinja2:suite.rc]\n")

             # Cycling and CRUN set-up
             fp.write('!!ARCHIVE_NAME="<Please specify>"\n')
             fp.write("CRUN_LEN=6\n")
             fp.write('HK_RUN=false,false\n')
             fp.write('CASE_STUDIES=false\n')
             fp.write("!!CASE_DATES='20150323T0000Z'\n")
             fp.write('INITIAL_CYCLE_POINT="20200705T0000Z"\n')
             fp.write('FINAL_CYCLE_POINT="20200705T0000Z"\n')
             fp.write('CYCLE_INT_HR=24\n')
             fp.write("FREE_RUN=false\n")
             fp.write('!!global_ostia_dir="<path to global OSTIA ancillary files>"\n')
             fp.write("USE_OSTIA=false\n")
             fp.write("!!USE_SMC=false\n")
             fp.write("MAKE_FRAMES=false\n")
             fp.write("!!USE_UKCA=false\n")
             fp.write("WALL_CLOCK_LIMIT=600\n")
             fp.write('!!BUILD_CREATEBC="no"\n')
             fp.write('BUILD_MODE="new"\n')
             fp.write("!!RUN_UM_LAM=true\n")
             fp.write("RUN_LFRIC_LAM=false\n")
             fp.write("!!POSTPROCESS_NPROCS=1\n")
             fp.write("!!POSTPROCESS_MEMORY=40\n")
             fp.write("!!POSTPROCESS_UMIFY=false\n")
             fp.write("!!POSTPROCESS_ARCHIVE=true\n")
             fp.write("!!RUN_LFRIC_POSTPROCESS=false\n")
             fp.write('!!EXEC_DIR="<path to model executable>"\n')
             fp.write('!!SPACK_VERSION="<path to model executable>"\n')
             fp.write('!!LFRIC_EXEC_DIR="<path to lfric build directory>"\n')
             fp.write('KGO_TEST=false\n')
             fp.write('SPECIFY_ARCHIVE_NAME=false\n')
             fp.write("\n")

             # HPC set-up
             fp.write('SITE="site"\n')
             fp.write('!!HOST_EX="please_specify"\n')
             fp.write('!!CORE_TYPE="please_specify"\n')
             fp.write('!!CHARGING_CODE="please_specify"\n')
             fp.write('!!HPC_USERID="please_specify"\n')
             fp.write("\n")

             # Driving model setup
             fp.write('dm_RUN_MODE="rerun_oper"\n')
             fp.write('dm_name="glm"\n')
             fp.write('dm_config="ga8_gl9"\n')
             fp.write('dm_resln="n1280"\n')
             fp.write("dm_nproc=24,24\n")
             fp.write("dm_nregns=1\n")
             fp.write("!!dm_runlen=120\n")
             fp.write("dm_cb_freq=3600\n")
             fp.write("!!dm_ec_cb_freq=10800\n")
             fp.write('!!dm_ec_lam_ancil_dir="<path to ancil directory>"\n')
             fp.write('!!dm_ec_ic_lbc_dir="<path to EC grib files directory>"\n')
             fp.write('!!dm_ec_mode="fcst"\n')
             fp.write('!!dm_ukv_lbcs="ukv_lbc"\n')
             fp.write("dm_lbc_rain=true\n")
             fp.write("dm_run_murk=false\n")
             fp.write('!!dm_ic_file="<path to analysis>"\n')
             fp.write('!!dm_lbc_files="<path to LBC creation files>"\n')
             fp.write('!!dm_UKCA_init_file="<path to UKCA prognostic init file>"\n')
             fp.write("dm_arch=false,false,false\n")
             fp.write("\n")

             fp.write(dedent("""
                 !!NCI_ERA5GRIB=false
                 !!NCI_STORAGE=""
                 !!NCI_STORAGE_TYPE='gdata'
                 !!NCI_STORAGE_TOP_DIR="unset"
                 !!dm_NCI_DATA_SRC='tape'
                 !!dm_nci_barra_ic="<path to analysis>"
                 !!dm_nci_barra_lbc="<path to LBC creation files>"
                 """))

             # Nesting model setup
             for rg in range(1, nrg + 1):
                 # Region rg
                 if rg > 1:
                     rgig = "!!"
                 else:
                     rgig = ""
                 fp.write('{0:s}rg{1:02d}_name="Regn{2:d}"\n'.format(rgig, rg, rg))
                 fp.write("{0:s}rg{1:02d}_nreslns=1\n".format(rgig, rg))
                 fp.write("\n")
                 for rs in range(1, nrs + 1):
                     if rg > 1 or rs > 1:
                         rsig = "!!"
                     else:
                         rsig = ""
                     # Region rg, resolution rs
                     fp.write('{0:s}rg{1:02d}_rs{2:02d}_ancil_dir="<path to ancillary versions file>"\n'.format(rsig, rg, rs))
                     fp.write('!!rg{1:02d}_rs{2:02d}_lfric_ancil_dir="<path to lfric ancillary versions file>"\n'.format(rsig, rg, rs))
                     fp.write('{0:s}rg{1:02d}_rs{2:02d}_vargrid="fixed"\n'.format(rsig, rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_zon_avg_ozone=false\n".format(rsig, rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_3D_ancils=false\n".format(rsig, rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_arcl_dust_anc=true\n".format(rsig, rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_downscale_ukv=false\n".format(rsig, rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_kscale=false\n".format(rsig, rg, rs))
                     fp.write("!!rg{0:02d}_rs{1:02d}_ioproc=48\n".format(rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_lai_anc=true\n".format(rsig, rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_alb_anc=false\n".format(rsig, rg, rs))
                     fp.write('{0:s}rg{1:02d}_rs{2:02d}_name="resn_{3:d}"\n'.format(rsig, rg, rs, rs))
                     fp.write('{0:s}rg{1:02d}_rs{2:02d}_levset="L70_40km"\n'.format(rsig, rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_nmods=1\n".format(rsig, rg, rs))
                     fp.write("{0:s}rg{1:02d}_rs{2:02d}_runlen=48\n".format(rsig, rg, rs))
                     fp.write('{0:s}rg{1:02d}_rs{2:02d}_std_model="custom"\n'.format(rsig, rg, rs))
                     fp.write("\n")
                     for m in range(1, nm + 1):
                         if rg > 1 or rs > 1 or m > 1:
                             mig = "!!"
                         else:
                             mig = ""
                         # Region rg, resolution rs, model m
                         fp.write('{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_name="RAL3P2"\n'.format(mig, rg, rs, m, m))
                         fp.write('{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_config="ral3p2"\n'.format(mig, rg, rs, m))
                         fp.write('!!rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_exp_blending=false\n'.format(rg, rs, m))
                         fp.write('!!rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_mix_mol=false\n'.format(rg, rs, m))
                         fp.write('!!rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_nproc=32,1,64,32,28,28,112\n'.format(rg, rs, m))
                         fp.write("!!rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_diagnostics=true,true,false,true,false\n".format(rg, rs, m))
                         fp.write("!!rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_arch=false\n".format(rg, rs, m))
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_progdust=false,false\n".format(mig, rg, rs, m))
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_stashpack=true,false,false,false,false,false,false\n".format(mig, rg, rs, m))
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_simim=false\n".format(mig, rg, rs, m))
                         fp.write("!!rg{0:02d}_rs{1:02d}_m{2:02d}_simim_freq=3\n".format(rg, rs, m))
                         fp.write("!!rg{0:02d}_rs{1:02d}_m{2:02d}_sat_name='MSG'\n".format(rg, rs, m))                         
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_moruses=false\n".format(mig, rg, rs, m))                         
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_nproc=18,18\n".format(mig, rg, rs, m))
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_dt=75\n".format(mig, rg, rs, m))
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_raddt=900,300\n".format(mig, rg, rs, m))
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_lbc_freq=3600,0\n".format(mig, rg, rs, m))
                         fp.write("!!rg{0:02d}_rs{1:02d}_m{2:02d}_ic_lbc_src={3:d},1\n".format(rg, rs, m, rs - 1))
                         fp.write("{0:s}rg{1:02d}_rs{2:02d}_m{3:02d}_arch=false,false,false\n".format(mig, rg, rs, m))
                         fp.write("\n")
    except IOError:
        raise UserWarning("Problem writing file" + f + "\n")


def set_metadata(f, nrg, nrs, nm):
    try:
        with open(f, "w") as fp:

             fp.write(dedent("""
                 [jinja2:suite.rc]
                 ns=jinja2:suite.rc
                 title=Nesting Suite
                 url=https://code.metoffice.gov.uk/trac/rmed/wiki/suites/nesting

                 # General run options
                 [ns=jinja2:suite.rc/run]
                 sort-key=sec-a
                 title=General run options

                 [jinja2:suite.rc=SITE]
                 ns=jinja2:suite.rc/run
                 sort-key=run-a
                 title=SITE
                 description=Select site where the nesting
                            =suite will be run
                 compulsory=true
                 values="site","mo1b-cray-xc40","mo1c-cray-xc40", "afw-hp-intel","icm-xc40-cce","icm-pwr7-xlf", "kma-cray-xc40","monsoon-cray-xc40","mss-cray-xc30","ncas-cray-ex", "nci-gadi", "ncmr-cray-xc40", "niwa-ibm-pwr6", "saws-cray-xc30", "ecmwf-cray-xc40", "moex-cray"
                 value-titles=Please select,Met Office xce/xcf,Met Office   xcs  ,AFW, ICM-cray,ICM-ibm,KMA,MONSooN,MSS,NCAS,NCI,NCMRWF,NIWA,SAWS,ECMWF,Met Office ex
                 trigger=jinja2:suite.rc=CHARGING_CODE: "mo1b-cray-xc40","mo1c-cray-xc40","monsoon-cray-xc40","kma-cray-xc40","ncas-cray-ex";
                         jinja2:suite.rc=HPC_USERID: "ncas-cray-ec";
                         jinja2:suite.rc=USE_UKCA: "mo1b-cray-xc40","mo1c-cray-xc40","monsoon-cray-xc40","moex-cray";
                         jinja2:suite.rc=HOST_EX: "moex-cray";
                         jinja2:suite.rc=BUILD_CREATEBC: "mo1b-cray-xc40";
                         jinja2:suite.rc=NCI_STORAGE: "nci-gadi";
                         jinja2:suite.rc=NCI_STORAGE_TYPE: "nci-gadi";
                         jinja2:suite.rc=NCI_STORAGE_TOP_DIR: "nci-gadi";
                         jinja2:suite.rc=NCI_ERA5GRIB: "nci-gadi";
                         jinja2:suite.rc=POSTPROCESS_ARCHIVE: "mo1c-cray-xc40","mo1b-cray-xc40";
                 """))

             fp.write(dedent("""
                 [jinja2:suite.rc=HOST_EX]
                 ns=jinja2:suite.rc/run
                 sort-key=run-a1
                 title=EX HOST
                 description=Select quadrant on EX where the nesting
                            =suite will be run
                 compulsory=true
                 values="exab","excd"
                 value-titles=EXA and EXB,EXC and EXD
                 trigger=jinja2:suite.rc=CORE_TYPE: "exab","excd";

                 [jinja2:suite.rc=CORE_TYPE]
                 ns=jinja2:suite.rc/run
                 sort-key=run-a2
                 compulsory=true
                 description=Milan has 128 processors per node. Genoa has 192 processors per node.
                 title=EX core type
                 value-titles=Milan, Genoa
                 values='milan','genoa'
                 """))

             fp.write(dedent("""
                 [jinja2:suite.rc=HPC_USERID]
                 ns=jinja2:suite.rc/run
                 sort-key=run-b
                 title=HPC_USERID
                 description=Set your HPC user ID. Only required for Archer currently.
                 help=This is currently only set for the NCAS supercomputer, Archer, and this is because the
                     =user ID is often different on PUMA to that on Archer.
                 type=quoted

                 [jinja2:suite.rc=CHARGING_CODE]
                 ns=jinja2:suite.rc/run
                 sort-key=run-c
                 title=CHARGING_CODE
                 description=Set accounting code HPC usage will be charged
                            =against. Currently only activated for
                            =Met Office, MONSooN and NCAS sites.
                 help=For Met Office users this needs to be "climate", "foundation" or "weather"
                     =For MONSooN and NCAS users this needs to be the name of the project that you are working on.
                 type=quoted
                 """))

             fp.write("[jinja2:suite.rc=RUN_LFRIC_LAM]\n")
             fp.write("ns=jinja2:suite.rc/run\n")
             fp.write("sort-key=run-c1\n")
             fp.write("title=RUN_LFRIC_LAM_IN_DEV_MODE\n")
             fp.write("description=TRUE then set up additional graphing\n")
             fp.write("           =and tasks for running an LFRic LAM.\n")
             fp.write("           =This functionality is still being developed\n")
             fp.write("           =FALSE then don't run an LFRic LAM (run only UM LAM tasks)\n")
             fp.write("help=When true a proto-ral LAM will be run nested inside the UM \n")
             fp.write("    =Global model. This will require a set\n")
             fp.write("    =of UM and LFRic ancillaries for each region/resolution.\n")
             fp.write("    =However PLEASE NOTE, that functionality\n")
             fp.write("    =to run LFRic Regional models is in development mode.\n")
             fp.write("    =\n")
             fp.write("    =Currently LFRic driving LFRic functionality is unavailable,\n")
             fp.write("    =therefore if running multiply nested LAMs, each LFRic LAM must be\n")
             fp.write("    =nested inside the UM. The current default is to nest each LFRic LAM in\n")
             fp.write("    =the n-1 UM model e.g. Resolution 1 LFRic LAM will be driven by the\n")
             fp.write("    =UM Global model, Resolution 2 LFRic LAM will be driven by the\n")
             fp.write("    =Resolution 1 UM LAM etc.\n")
             fp.write("    =\n")
             fp.write("    =Please contact the RNS owner for further details.\n")
             fp.write("compulsory=true\n")
             fp.write("type=boolean\n")
             fp.write("trigger=jinja2:suite.rc=RUN_UM_LAM: true;\n")
             fp.write("       =jinja2:suite.rc=LFRIC_EXEC_DIR: true;\n")
             fp.write("       =jinja2:suite.rc=RUN_LFRIC_POSTPROCESS: true;\n")
             for rg in range(1, nrg + 1):
                 for rs in range(1, nrs + 1):
                     fp.write("       =jinja2:suite.rc=rg{0:02d}_rs{1:02d}_lfric_ancil_dir: true;\n".format(rg, rs))
#                     fp.write("       =jinja2:suite.rc=rg{0:02d}_rs{1:02d}_std_model: false;\n".format(rg, rs))
#                     fp.write("       =jinja2:suite.rc=rg{0:02d}_rs{1:02d}_vargrid: false ;\n".format(rg, rs))
                     for  m in range(1, nm + 1):
                         fp.write("       jinja2:suite.rc=rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_exp_blending: true;\n".format(rg,rs,m))
                         fp.write("       jinja2:suite.rc=rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_mix_mol: true;\n".format(rg,rs,m))
                         fp.write("       jinja2:suite.rc=rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_nproc: true;\n".format(rg,rs,m))
                         fp.write("       jinja2:suite.rc=rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_diagnostics: true;\n".format(rg,rs,m))
                         fp.write("       jinja2:suite.rc=rg{0:02d}_rs{1:02d}_m{2:02d}_lfric_arch: true;\n".format(rg,rs,m))
             fp.write('fail-if=(this == "true") and jinja2:suite.rc=FREE_RUN == "true"; # functionality to run LFRic LAMs in FREE_RUN mode has not been added yet\n')
             fp.write("\n")

             fp.write("[jinja2:suite.rc=RUN_UM_LAM]\n")
             fp.write("ns=jinja2:suite.rc/run\n")
             fp.write("sort-key=run-c2\n")
             fp.write("title=RUN_UM_LAM\n")
             fp.write("description=TRUE then run a UM LAM in addition to an LFRic LAM\n")
             fp.write("           =FALSE don't run a UM LAM (run an LFRic LAM only)\n")
             fp.write("help=When true this switch will run a UM LAM forecast in\n")
             fp.write("    =addition to an LFRic LAM.\n")
             fp.write("    =If running multiply nested LAMs this switch should be set to True\n")
             fp.write("    =as currently each LFRic LAM must be driven by a UM parent model.\n")
             fp.write("    =Note that some UM tasks are still run when this is set to False as\n")
             fp.write("    =they are required by the LFRic LAM.\n")
             fp.write("    =This trigger is being added as part of ongoing work \n")
             fp.write("    =to run LFRic LAMs within the RNS\n")
             fp.write("    =when running LFRic LAMs is fully implemented.\n")
             fp.write("    =Please contact the RNS owner for further details.\n")    
             fp.write("compulsory=true\n")
             fp.write("type=boolean\n")
             fp.write('warn-if=(this == "false") ; # This must be set to true if you want to run a UM LAM in the RNS\n')
             fp.write("\n")
             fp.write("[jinja2:suite.rc=RUN_LFRIC_POSTPROCESS]\n")
             fp.write("ns=jinja2:suite.rc/run\n")
             fp.write("sort-key=run-c3\n")
             fp.write("title=RUN_LFRIC_POSTPROCESS\n")
             fp.write("description=TRUE then output unstructured LFRic data is\n")
             fp.write("           =processed onto a structured grid.\n")
             fp.write("           =FALSE then output LFRic data isn't processed\n")
             fp.write("help=When true this switch will run a postprocessing task before archiving\n")
             fp.write("    =LFRic LAM ugrid data. This task will pull data from MASS and then SLAM\n")
             fp.write("    =(re-structured) the output LFRic data and optionally run a metadata conversion.\n")
             fp.write("    =CAUTION: running this task on SPICE requires a working conda installation\n")
             fp.write("    =because the `geovista-slam` python library is required. Please ensure that\n")
             fp.write("    =archiving is switched on since this task retrieves data from MASS.\n")
             fp.write("type=boolean\n")
             fp.write("trigger=jinja2:suite.rc=POSTPROCESS_UMIFY: true;\n")
             fp.write("       =jinja2:suite.rc=POSTPROCESS_NPROCS: true;\n")
             fp.write("       =jinja2:suite.rc=POSTPROCESS_MEMORY: true;\n")
             fp.write("       =jinja2:suite.rc=POSTPROCESS_ARCHIVE: true;\n")
             fp.write("\n")
             fp.write("[jinja2:suite.rc=POSTPROCESS_UMIFY]\n")
             fp.write("ns=jinja2:suite.rc/run\n")
             fp.write("sort-key=run-c4\n")
             fp.write("title=POSTPROCESS_UMIFY\n")
             fp.write("description=Determines if UMified data is produced\n")
             fp.write("           =alongside SLAM-only data.\n")
             fp.write("help=The lfric_postprocess task produces NetCDF files containing metadata\n")
             fp.write("    =which can be UMified (made to look like UM metadata).\n")
             fp.write("    =UMification isn't recommended for data to be processed with CSET.\n")
             fp.write("type=boolean\n")
             fp.write("\n") 
             fp.write("[jinja2:suite.rc=POSTPROCESS_NPROCS]\n")
             fp.write("ns=jinja2:suite.rc/run\n")
             fp.write("sort-key=run-c6\n")
             fp.write("title=POSTPROCESS_NPROCS\n")
             fp.write("description=Allocates number of processors for the \n")
             fp.write("           =postprocessing of LFRic data.\n")
             fp.write("help=Specify number of processors as an integer.\n")
             fp.write("type=integer\n")
             fp.write("range=1:256\n")
             fp.write("\n")
             fp.write("[jinja2:suite.rc=POSTPROCESS_MEMORY]\n")
             fp.write("ns=jinja2:suite.rc/run\n")
             fp.write("sort-key=run-c6\n")
             fp.write("title=POSTPROCESS_MEMORY\n")
             fp.write("description=Allocates memory for the \n")
             fp.write("           =postprocessing of LFRic data.\n")
             fp.write("help=Specify memory for task in GB as an integer.\n")
             fp.write("type=integer\n")
             fp.write("range=1:256\n")
             fp.write("\n")
             fp.write("[jinja2:suite.rc=POSTPROCESS_ARCHIVE]\n")
             fp.write("ns=jinja2:suite.rc/run\n")
             fp.write("sort-key=run-c6\n")
             fp.write("title=POSTPROCESS_ARCHIVE\n")
             fp.write("description=Archive the re-structured LFRic  \n")
             fp.write("           =data to MASS.\n")
             fp.write("help=Postprocessed data is archived to MASS. Only available if SITE is MetOffice.\n")
             fp.write('warn-if=(this == "false") and jinja2:suite.rc=RUN_LFRIC_POSTPROCESS == "true"; # Postprocessed output files will be deleted in the housekeeping task. Check this is OK.\n')
             fp.write("type=boolean\n")
             fp.write(dedent("""
                 [jinja2:suite.rc=BUILD_MODE]
                 ns=jinja2:suite.rc/run
                 sort-key=run-d
                 title=BUILD_MODE
                 description=A single build step to produce
                            =reconfiguration and forecast executables
                            =for both driving and nested models.
                 help=Build new executable
                     =The executable will be built when you rose suite-run your suite.
                     =Any new branch added to the suite must now include switches to ensure
                     =that the configurations not using the branch continue to work.
                     =
                     =Use executable made by a previous run of this suite.
                     =This will use the executable built by a previous run of this
                     =suite.
                     =
                     =Use some other executable on disk.
                     =A user-specifed executable that already exists.
                     =See the help for EXEC_DIR as to how to specify the path.
                 values="new","useprev","spack","custom"
                 value-titles=Build new executable, Use executable made by a previous run of this suite, Use some other executable on disk
                 compulsory=true
                 trigger=jinja2:suite.rc=EXEC_DIR: "custom";
                        =jinja2:suite.rc=LFRIC_EXEC_DIR: "custom";
                        =jinja2:suite.rc=SPACK_VERSION: "spack";

                 [jinja2:suite.rc=BUILD_CREATEBC]
                 ns=jinja2:suite.rc/run
                 sort-key=run-d1
                 title=BUILD_CREATEBC
                 values="no","new","useprev"
                 compulsory=true
                 description=Decide if compilation of CreateBC is needed
                 value-titles=Link from central site installation,
                             =Build in suite,
                             =Use from build in previous suite run
                 help=Build CreateBC executable or use existing executable
                     =
                     =In-suite builds of CreateBC allow to test and use CreateBC features
                     =which are under development, i.e. only available on branches for now.
                     =Please adjust the sources in the fcm_make_createbc app accordingly
                     =and remember that it could be appropriate to get your developments
                     =included in the trunk of CreateBC.
