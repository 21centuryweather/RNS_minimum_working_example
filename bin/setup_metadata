             fp.write("sort-key=dm-r\n")
             fp.write("title=dm_nregns\n")
             fp.write("description=Number of nested regions\n")
             fp.write("help=Number of geographical regions to nest inside the driving model. This allows\n")
             fp.write("    =high-resolution modelling of several interesting weather events occuring at\n")
             fp.write("    =different places in the driving model domain at the same time. For example,\n")
             fp.write("    =on a particular day there may be tropical cyclones active at several places\n")
             fp.write("    =on Earth.\n")
             fp.write("    =\n")
             fp.write("    =Setting dm_nregns to zero allows the user to run the driving model only.\n")
             fp.write("    =\n")
             fp.write("    =As it is likely that most users will only need one geographical region,\n")
             fp.write("    =the GUI and metadata are by default set up to have a maximum of 1 region, \n")
             fp.write("    =a maximum of 5 resolutions (per region), and a maximum of 3 model configurations \n")
             fp.write("    =(per model resolution).\n")
             fp.write("    =\n")
             fp.write("    =To change any of these defaults, go into the bin directory and type \n")
             fp.write("    ='./setup_metadata 1 5 3' replacing any of the numbers with your preference. \n")
             fp.write("    =Note that you will then have to work through the GUI afresh as a new \n")
             fp.write("    =rose-suite.conf is generated by this command. Furthermore,  if you increase  \n")
             fp.write("    =the total number of possible model configurations significantly (by \n")
             fp.write("    =increasing any or all of the three numbers), the GUI can become slow to load up.\n")
             fp.write("    =\n")
             fp.write("type=integer\n")
             fp.write("range=0:{0:d}\n".format(nrg))
             fp.write("trigger=jinja2:suite.rc=dm_runlen: this == 0;\n")
             fp.write("        jinja2:suite.rc=dm_lbc_files: this > 0;\n")
             fp.write("        jinja2:suite.rc=dm_lbc_rain: this > 0;\n")
             fp.write("        jinja2:suite.rc=dm_run_murk: this > 0;\n")
             for rg in range(1, nrg + 1):
                 fp.write("        jinja2:suite.rc=rg{0:02d}_name: this >= {1:d};\n".format(rg, rg))
                 fp.write("        jinja2:suite.rc=rg{0:02d}_nreslns: this >= {1:d};\n".format(rg, rg))
             fp.write('fail-if=this == 0 and (jinja2:suite.rc=dm_RUN_MODE[1:-1] == "oper" or jinja2:suite.rc=dm_RUN_MODE[1:-1] == "custom"); # Number of nested regions must be greater than 0\n')
             fp.write('fail-if=this > 0 and jinja2:suite.rc=RUN_UM_LAM == "false" and jinja2:suite.rc=RUN_LFRIC_LAM == "false"; # In order to run nested LAM domains you must set either RUN_UM_LAM or RUN_LFRIC_LAM to true\n')
             fp.write("\n")

             # Nested regions
             for rg in range(1, nrg + 1):
                 fp.write("# Region {0:02d}\n".format(rg))
                 fp.write("[ns=jinja2:suite.rc/rg{0:02d}]\n".format(rg))
                 fp.write("title=Nested region {0:d} setup\n".format(rg))
                 fp.write("\n")

                 fp.write("[jinja2:suite.rc=rg{0:02d}_name]\n".format(rg))
                 fp.write("ns=jinja2:suite.rc/rg{0:02d}\n".format(rg))
                 fp.write("sort-key=rg{0:02d}-b\n".format(rg))
                 fp.write("title=rg{0:02d}_name\n".format(rg))
                 fp.write("description=Region name\n")
                 fp.write("type=quoted\n")
                 fp.write('fail-if="." in this; # Region name cannot contain a period\n')
                 ################################################################################################
                 #fp.write('pattern=^"[^.]*"$\n')
                 ################################################################################################
                 fp.write("\n")

                 fp.write("[jinja2:suite.rc=rg{0:02d}_nreslns]\n".format(rg))
                 fp.write("ns=jinja2:suite.rc/rg{0:02d}\n".format(rg))
                 fp.write("sort-key=rg{0:02d}-h\n".format(rg))
                 fp.write("title=rg{0:02d}_nreslns\n".format(rg))
                 fp.write("description=Number of resolutions\n")
                 fp.write("help=This defines the number of nested model resolutions for this region.\n")
                 fp.write("    =For example, setting it to 3 allows models to be triply nested inside\n")
                 fp.write("    =the driving model, such as Global -> 4.4 km -> 1.5 km -> 300 m.\n")
                 fp.write("    =\n")
                 fp.write("    =As it is likely that most users will only need a maximum of 5 resolutions,,\n")
                 fp.write("    =the GUI and metadata are by default set up to have a maximum of 1 region, \n")
                 fp.write("    =a maximum of 5 resolutions (per region), and a maximum of 3 model configurations \n")
                 fp.write("    =(per model resolution).\n")
                 fp.write("    =\n")
                 fp.write("    =To change any of these defaults, go into the bin directory and type \n")
                 fp.write("    ='./setup_metadata 1 5 3' replacing any of the numbers with your preference. \n")
                 fp.write("    =Note that you will then have to work through the GUI afresh as a new \n")
                 fp.write("    =rose-suite.conf is generated by this command. Furthermore,  if you increase  \n")
                 fp.write("    =the total number of possible model configurations significantly (by \n")
                 fp.write("    =increasing any or all of the three numbers), the GUI can become slow to load up.\n")
                 fp.write("    =\n")
                 fp.write("type=integer\n")
                 fp.write("range=1:{0:d}\n".format(nrs))
                 for rs in range(1, nrs + 1):
                     if rs == 1:
                         fp.write("trigger=jinja2:suite.rc=rg{0:02d}_rs{1:02d}_std_model: this >= {2:d};\n".format(rg, rs, rs))
                     else:
                         fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_std_model: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_name: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_ancil_dir: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_lfric_ancil_dir: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_vargrid: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_3D_ancils: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_arcl_dust_anc: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_downscale_ukv: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_kscale: this>= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_ioproc: this>= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_lai_anc: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_alb_anc: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_levset: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_nmods: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_runlen: this >= {2:d};\n".format(rg, rs, rs))
                     fp.write("        jinja2:suite.rc=rg{0:02d}_rs{1:02d}_zon_avg_ozone: this >= {2:d};\n".format(rg, rs, rs))
                 fp.write("\n")

                 for rs in range(1, nrs + 1):
                     fp.write("# Region {0:02d}, model {1:02d}\n".format(rg, rs))
                     fp.write("[ns=jinja2:suite.rc/rg{0:02d}/rs{1:02d}]\n".format(rg, rs))
                     fp.write("title=Resolution {0:d} setup\n".format(rs))
                     fp.write("\n")

                     fp.write("[jinja2:suite.rc=rg{0:02d}_rs{1:02d}_std_model]\n".format(rg, rs))
