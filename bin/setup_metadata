             fp.write("[jinja2:suite.rc=FREE_RUN]\n")
             fp.write("ns=jinja2:suite.rc/cycle\n")
             fp.write("sort-key=cycle-f\n")
             fp.write("title=FREE_RUN\n")
             fp.write("description=Specifies whether nested regional models are to\n")
             fp.write("           =be free running or re-initialised every cycle.\n")
             fp.write("           =DO NOT USE WITH CASE_STUDIES set to TRUE \n")
             fp.write("           =------------------------------------------------------------------- \n")
             fp.write("           = \n")
             fp.write("help=If this is set to true, the driving model will be re-initialised every\n")
             fp.write("    =CYCLE_INT_HR hours between the trial start and end times.\n")
             fp.write("    =Nested regional models will only be initialised at start of the trial.\n")
             fp.write("    =and hence are 'free-running'. This is the closest to reality that the Met\n")
             fp.write("    =Office high resolution modelling system allows.\n")
             fp.write("    =\n")
             fp.write("    =N.B. The FREE_RUN option is not available when running in CASE_STUDIES=true mode.\n")
             fp.write("    =\n")
             fp.write("    =When a new cycle commences, continuation of the regional model runs is done by using\n")
             fp.write("    =the dump written out at the end of the previous cycle. If CYCLE_INT_HR=6 hours then\n")
             fp.write("    =the 06Z cycle will use that dump as input to a reconfiguration step which will update\n")
             fp.write("    =the time evolving ancillaries (aerosols, veg functional types and optionally OSTIA SSTS).\n")
             fp.write("    =In this way, if OSTIA SSTs are being used, they are input into the models in the same way \n")
             fp.write("    =they are operationally at the Met Office. The 00z, 12z and 18z cycles then just use the \n")
             fp.write("    =end of previous cycle dump as their initial conditions.\n")
             fp.write("\n")
             fp.write("    =If CYCLE_INT_HR>6 hours then this reconfiguration step is done every cycle.  \n")
             fp.write("\n")
             fp.write("    =One side effect of using the end of previous cycle dump as the new cycle initial \n")
             fp.write("    =conditions is that the model 'forgets' any running totals. So if the user\n")
             fp.write("    =is interested in accumulations, it is recommended to use time profiles tailored\n")
             fp.write("    =for the accumulation periods of interest instead, making sure that the\n")
             fp.write("    =accumulation period divides exactly into CYCLE_INT_HR.\n")
             fp.write("compulsory=true\n")
             fp.write("type=boolean\n")
             fp.write("trigger=jinja2:suite.rc=dm_runlen: false;\n")
             for rg in range(1, nrg + 1):
