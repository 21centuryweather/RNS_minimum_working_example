             fp.write("description=Output frequency of fields for\n")
             fp.write("           =LBC creation in seconds\n")
             fp.write("help=If re-running the driving model as part of the nesting suite, this is the frequency\n")
             fp.write("    =with which fields necessary for the subsequent generation of lateral boundary\n")
             fp.write("    =conditions (LBCs) for nested regional models will be written out.\n")
             fp.write("    =\n")
