                     fp.write("trigger=jinja2:suite.rc=rg{0:02d}_rs{1:02d}_ioproc: this == 'true' ;\n".format(rg, rs))
                     fp.write("\n")
                    
                     fp.write("[jinja2:suite.rc=rg{0:02d}_rs{1:02d}_ioproc]\n".format(rg, rs))
