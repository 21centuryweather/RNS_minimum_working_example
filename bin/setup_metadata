                         fp.write("    =The second element specifies the output frequency (in seconds) of the fields output\n")
                         fp.write("    =by this model to enable the subsequent generation of lateral boundary conditions\n")
                         fp.write("    =(LBCs) for models nested inside this model.\n")
                         fp.write("    =\n")
                         fp.write("    =The output frequency must be an integer multiple of the model time-step\n")
                         fp.write("    =and also divide into CRUN_LEN.\n")
                         fp.write("    =\n")
                         fp.write("    =To turn off the production of LBC creation files, set this to zero. \n")
                         fp.write("    =\n")
                         fp.write("type=integer,integer\n")
                         fp.write("range=0:\n")
                         fp.write("fail-if=(jinja2:suite.rc=CRUN_LEN * 60 * 60) % this(1); # LBC frequency must divide into the specified CRUN length\n")
                         fp.write("        (this(2) > 0) and ((jinja2:suite.rc=CRUN_LEN * 60 * 60) % this(2)); # Output frequency of LBC creation files must divide into the specified CRUN length\n")
                         fp.write("        (this(2) > 0) and (this(2) % jinja2:suite.rc=rg{0:02d}_rs{1:02d}_m{2:02d}_dt); # Output frequency of LBC creation files must be a multiple of the model time-step\n".format(rg, rs, m))
                         fp.write("\n")

                         fp.write("[jinja2:suite.rc=rg{0:02d}_rs{1:02d}_m{2:02d}_arch]\n".format(rg, rs, m))
                         fp.write("ns=jinja2:suite.rc/rg{0:02d}/rs{1:02d}/m{2:02d}\n".format(rg, rs, m))
                         fp.write("sort-key=rg{0:02d}_rs{1:02d}_m{2:02d}-n\n".format(rg, rs, m))
                         fp.write("title=rg{0:02d}_rs{1:02d}_m{2:02d}_arch\n".format(rg, rs, m))
                         fp.write("description=Archiving of:-\n")
                         fp.write("    =(i)   LBC creation (aka 'cb') files \n")
                         fp.write("    =(ii)  the start dump \n")
                         fp.write("    =(iii) fields (STASH output in fieldsfile format for the UM). \n")
                         fp.write("help=MASS archiving. \n")
                         fp.write("    =Currently only available on Met Office and Monsoon systems. \n")
                         fp.write("    = \n")
                         fp.write("type=boolean,boolean,boolean\n")
                         fp.write('warn-if=(this == "false") and jinja2:suite.rc=HK_RUN == "true"; # Housekeeping is on but you are not archiving model LBC creation files. Check this is OK\n')
                         fp.write("\n")

                         fp.write("[jinja2:suite.rc=rg{0:02d}_rs{1:02d}_m{2:02d}_moruses]\n".format(rg, rs, m))
                         fp.write("ns=jinja2:suite.rc/rg{0:02d}/rs{1:02d}/m{2:02d}\n".format(rg, rs, m))
                         fp.write("sort-key=rg{0:02d}_rs{1:02d}_m{2:02d}-f5\n".format(rg, rs, m))
                         fp.write("title=rg{0:02d}_rs{1:02d}_m{2:02d}_moruses\n".format(rg, rs, m))
                         fp.write("description=Run MORUSES 2-tile urban surface exchange scheme\n")
                         fp.write("help=MORUSES is an urban surface-energy balance (SEB) scheme that calculates\n")
                         fp.write("    =the SEB for roof and street canyon tiles separately (Porson et al., 2010a,b).\n")
                         fp.write("    =\n")
                         fp.write("    =Ancillaries should contain 10 tiles (i.e., one canyon and one roof tile)\n")
                         fp.write("    =rather than the 9 tiles (i.e., one urban tile) required for the Best et al.\n")
                         fp.write("    =2011 scheme. Ancillaries can be generated using the Regional Ancillary \n")                         
                         fp.write("    =Suite (RAS), and under the RAS panel 'resolution # setup', rg#_rs#_moruses\n")
                         fp.write("    = should be set to True.\n")
                         fp.write("    =\n")
                         fp.write("    =The start dump can contain 10 or 9 tiles.\n")
                         fp.write("    =\n")
                         fp.write("    =Note that when rg#_rs_std_model is a UKV version rather than user sepcified,\n")
                         fp.write("    =rg#_rs#_MORUSES does not appear in the GUI, since MORUSES is already\n")
                         fp.write("    =turned on in the UKV.\n")
                         fp.write("type=boolean\n")
                         fp.write("\n")

    except IOError:
        raise UserWarning("Problem writing file" + f + "\n")


def main(inargs):
    narg = len(inargs)
    if narg != 3:
        print( "Error: incorrect number of input arguments")
        print( "Usage: setup_metadata <maximum number of regions> <maximum number of resolutions per region> <maximum number of models per resolution> ")
        exit(1)
    maxnregn = int(inargs[0])
    maxnresln = int(inargs[1])
    maxnmod = int(inargs[2])

    confdir = os.path.split(os.getcwd())[0] + "/"
    metadir = confdir + "meta/"

    metafile = metadir + "rose-meta.conf"
    conffile = confdir + "rose-suite.conf"

    set_suite_conf(conffile, maxnregn, maxnresln, maxnmod)
    set_metadata(metafile, maxnregn, maxnresln, maxnmod)


if __name__=='__main__':
    main(sys.argv[1:])
